      "artboard": "header nav",
      "page": ".av-shell__nav ul",
      "allow": [
        "rect.y",
        "rect.h",
        "fontWeight"
      ]
    },
    {
      "name": "nav Today",
      "artboard": "header nav a:nth-child(1)",
      "page": ".av-shell__nav li:nth-child(1) a",
      "allow": [
        "rect.y",
        "rect.h",
        "fontWeight"
      ]
    },
    {
      "name": "nav Cases",
      "artboard": "header nav a:nth-child(2)",
