# Copy to api/.env for local development. Never commit real values.
# In staging/production these live in DigitalOcean App Platform encrypted env vars and GitHub secrets.

# Cell and packs
REGION=uk                          # cell: uk (launch), later au, ca
ALLOWED_PACKS=gb-eaw/clin-neg-breach/general-practice   # comma-separated jurisdiction/case-type/specialty combos; overlay chosen automatically
APP_ORIGIN=http://localhost:5173   # comma-separated allow-list of web origins; never a wildcard
COOKIE_DOMAIN=                     # empty locally (same origin); production: avodeck.com, so the page can read av_csrf (ADR 0031)
SESSION_SECRET=

# Database (ADR 0013): restricted roles, never the service role for data
DATABASE_URL=                      # app_api via Supavisor, transaction mode (pooled)
DATABASE_URL_DIRECT=               # app_worker, direct connection (job queue needs LISTEN/NOTIFY)
# Local (supabase start; passwords from supabase/seed.sql):
#   DATABASE_URL=postgresql://app_api:app_api_local@127.0.0.1:55322/postgres
#   DATABASE_URL_DIRECT=postgresql://app_worker:app_worker_local@127.0.0.1:55322/postgres
DATABASE_URL_LISTEN=               # optional: app_api on a DIRECT or SESSION-mode URL (port 5432), never transaction mode; one LISTEN connection per API process pushes live updates. Unset = streams poll on a timer
SSE_SAFETY_POLL_SECONDS=           # default 30: with DATABASE_URL_LISTEN set, a live stream still looks this often in case a notification is lost
DATABASE_URL_MIGRATOR=             # app_migrator, CI and deploys only, never the running app

# Supabase (London): Auth admin calls only (Storage moved to S3 in ADR 0032)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # used only for Supabase Auth admin calls
SUPABASE_JWKS_URL=
WORKER_CONCURRENCY=4               # jobs one worker runs at once
WORKER_DB_POOL_MAX=10              # the worker's own database pool (model calls in flight stay under it)
WORKER_QUEUE_POOL_MAX=4            # the job queue library's pool; the two must add up to less than the
                                   # session pooler's pool size (Supabase: 15 by default, raise it in the dashboard)
API_DB_ACQUIRE_TIMEOUT_SECONDS=2.0 # API only: wait this long for a free connection, then answer 503 busy
API_DB_MAX_WAITING=50              # API only: more requests than this waiting for a connection get 503 busy at once
API_DB_STATEMENT_TIMEOUT_MS=5000   # API only: a statement running longer is cancelled (503 busy); 0 = no limit

# AWS (eu-west-2). App Platform can't assume roles: one scoped IAM user per service, keys rotated every 90 days
AWS_REGION=eu-west-2
AWS_ALLOWED_REGIONS=eu-west-2      # rule 5: refuse any region not in this comma list
AWS_ACCESS_KEY_ID=                 # set both keys for Bedrock (live) and S3 (case files)
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=case-files          # S3 bucket for case files (chunks stored encrypted)
# S3_ENDPOINT_URL=                 # local only: moto or localstack (refused unless 127.0.0.1/localhost/[::1])
BEDROCK_SONNET_MODEL_ID=           # London in-region ID only
BEDROCK_OPUS_MODEL_ID=             # London in-region ID only
KMS_KEY_ARN=                       # cell key for per-case envelope encryption (ADR 0010)
KEY_PROVIDER=local                 # local (stage 1) | kms (stage 2 onward)
LOCAL_MASTER_KEY=                  # KEY_PROVIDER=local only: 32 random bytes, base64 (openssl rand -base64 32)
# BEDROCK_OVERFLOW_MODEL_IDS=      # optional: comma-separated London in-region model IDs tried when the primary is throttled (own quota each)
BEDROCK_ENDPOINT=                  # https://bedrock-runtime.<home region>.amazonaws.com
AI_ENDPOINT_ALLOW_LIST=            # comma-separated hosts the AI kit may call (Bedrock, Azure DI, Azure Speech)
# Cost guard (F11): a case pauses once its tokens pass MULTIPLE x EXPECTED_TOKENS_PER_PAGE x max(pages, MIN_EXPECTED_PAGES).
# The worker trips the guard and the API tells the person the case "has used up its allowance": set these three
# IDENTICALLY on the api and the worker (Railway shared variables), or the screen and the worker disagree.
AI_EXPECTED_TOKENS_PER_PAGE=4000
AI_MIN_EXPECTED_PAGES=100
AI_COST_GUARD_MULTIPLE=3
# The share (more than 0, at most 1) of a page's words the entries read from it must cover. Blank means 0.8.
AI_ENTRY_COVERAGE_FLOOR=
# TEMPORARY, dummy data only (ADR 0036): bedrock (default, or unset) | anthropic. Never anthropic with a real bundle.
AI_PRIMARY_PROVIDER=
ANTHROPIC_API_KEY=                 # needed only when AI_PRIMARY_PROVIDER=anthropic

# Azure (UK South)
AZURE_DI_ENDPOINT=                 # https://<resource>.cognitiveservices.azure.com (home region)
AZURE_DI_KEY=                      # set to switch OCR to live Document Intelligence (else AI_RECORDINGS_DIR, else none)
AZURE_SPEECH_REGION=uksouth
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=             # wss://<home region>.stt.speech.microsoft.com

# Pipeline (local until cloud scanners/embedders are configured)
    VIRUS_SCANNER=recorded   # a cell sets clamd with CLAMD_HOST, CLAMD_PORT=3310, CLAMD_TIMEOUT_S=60 (ADR 0026),
    EMBEDDER=recorded,
    VIRUS_SCANNER=recorded,
    EMBEDDER=recorded                      # onnx: bge-small in this process (ADR 0029); files in MODELS_DIR,
    RERANKER=                              # onnx: MiniLM cross-encoder for T-11 link candidates; empty keeps embedding order,
    MODELS_DIR=/opt/models                 # scripts/fetch_models.py DEST fills it; the image bakes it in,

# Email (no patient data)
RESEND_API_KEY=
EMAIL_FROM=no-reply@mail.avodeck.com   # verified sending domain

# Monitoring (EU)
SENTRY_DSN=                        # empty locally: no error reporting
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.05     # share of requests traced, 0 to 1
OPS_METRICS_TOKEN=                 # bearer token for GET /v1/internal/metrics; empty = the route answers 404
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Phase 2 (slice O): Avodeck's own subscription billing
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Local only: sign in with the password alone, no 6-digit code. Refused unless SUPABASE_URL is local.
# DEV_SKIP_MFA=1

