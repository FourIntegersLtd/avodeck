{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guideline sources",
  "type": "object",
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "enabled": {
            "type": "boolean"
          },
          "ai_use_approved": {
            "type": "boolean"
          }
        },
        "additionalProperties": true,
        "required": [
          "key"
        ]
      }
    },
    "priority_guidelines": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
