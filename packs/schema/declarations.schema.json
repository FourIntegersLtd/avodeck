{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declaration front matter",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "rule_ref": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "verify_before_launch": {
      "type": "boolean"
    },
    "verified_by": {
      "type": "string",
      "minLength": 1,
      "description": "Role and firm of the lawyer who checked the wording; no personal email"
    },
    "verified_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "key",
    "rule_ref",
    "version"
  ],
  "if": {
    "properties": {
      "verify_before_launch": {
        "const": false
      }
    },
    "required": [
      "verify_before_launch"
    ]
  },
  "then": {
    "required": [
      "verified_by",
      "verified_on"
    ]
  }
}
