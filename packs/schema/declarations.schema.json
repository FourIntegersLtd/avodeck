{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declaration front matter",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "rule_ref": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "verify_before_launch": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "key",
    "rule_ref",
    "version"
  ]
}
