{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline lanes",
  "type": "object",
  "properties": {
    "lanes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "key"
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "lanes"
  ]
}
