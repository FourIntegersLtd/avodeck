{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case-type pack metadata",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "retired"
      ]
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "expert_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 1
    },
    "party_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 1
    },
    "instructing_party_types": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 1
    },
    "document_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "subject_statuses": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "The states the subject of the case can be in (e.g. living). Labels and representative words come from the jurisdiction vocabulary (subject_statuses, subject_representatives)."
    },
    "blind_read_duties": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": ["named_expert"],
      "description": "Case roles who must read a page before seeing its suggestions (rule 3). named_expert must always be in this list for any pack where the named expert gives evidence."
    },
    "verification_duties": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "default": ["named_expert"],
      "description": "Case roles who may verify a fact. named_expert must always be in this list for any pack where the named expert signs the report."
    }
  },
  "additionalProperties": false,
  "required": [
    "code",
    "name",
    "version",
    "expert_roles",
    "party_roles",
    "instructing_party_types"
  ]
}
