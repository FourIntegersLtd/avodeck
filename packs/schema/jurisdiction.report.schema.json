{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report compliance checklist",
  "type": "object",
  "properties": {
    "rule_ref": {
      "type": "string",
      "minLength": 1
    },
    "page_limit": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required_contents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "enabled": {
            "type": "boolean"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "text_key": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "key"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "rule_ref",
    "required_contents"
  ]
}
