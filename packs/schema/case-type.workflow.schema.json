{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow steps",
  "type": "object",
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "meters": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "screens": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "key",
          "screens"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "steps"
  ]
}
