{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fact kinds",
  "type": "object",
  "properties": {
    "fact_kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "enabled": {
            "type": "boolean"
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "minProperties": 1,
            "additionalProperties": {
              "enum": [
                "string",
                "integer",
                "number",
                "date",
                "boolean"
              ]
            }
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "description": "The kind's name on screen, in the pack's words."
          },
          "field_labels": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Each field's name on screen, in the pack's words; one per field."
          },
          "author_field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "The field naming who saw the patient (screen 12 author line); one of the kind's fields."
          },
          "arrives": {
            "type": "boolean",
            "description": "Arrives from outside (a result, a letter): never treated as available on its own event date."
          }
        },
        "additionalProperties": false,
        "required": [
          "key"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "fact_kinds"
  ]
}
