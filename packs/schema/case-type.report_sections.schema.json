{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report sections",
  "type": "object",
  "properties": {
    "sections": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "enabled": {
                "type": "boolean"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "The heading the expert sees for this entry, in the pack's language."
              }
            },
            "additionalProperties": false,
            "required": [
              "key"
            ]
          }
        ]
      }
    },
    "appendices": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "enabled": {
                "type": "boolean"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "The heading the expert sees for this entry, in the pack's language."
              }
            },
            "additionalProperties": false,
            "required": [
              "key"
            ]
          }
        ]
      }
    },
    "opinion_per": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "uses_points_against": {
      "type": "boolean"
    },
    "uses_as_clinician_saw_it": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "sections"
  ]
}
