{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Overlay pack metadata",
  "type": "object",
  "properties": {
    "jurisdiction": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "specialty": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "retired"
      ]
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "jurisdiction",
    "specialty",
    "version"
  ]
}
