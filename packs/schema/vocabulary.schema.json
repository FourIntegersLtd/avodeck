{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vocabulary (any layer)",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "additionalProperties": {
    "oneOf": [
      {
        "type": "string",
        "minLength": 1
      },
      {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    ]
  }
}
