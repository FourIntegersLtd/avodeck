{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specialty pack metadata",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "retired"
      ]
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "profession": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "coverage_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "outside_expertise_question_types": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "code",
    "name",
    "version",
    "profession"
  ]
}
