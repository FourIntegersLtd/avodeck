{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specialty pack metadata",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "retired"
      ]
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "profession": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "coverage_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "outside_expertise_question_types": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "record_gaps": {
      "type": "object",
      "description": "Thresholds for where a record source goes quiet.",
      "additionalProperties": false,
      "properties": {
        "header_min_pages": {
          "type": "integer",
          "minimum": 1
        },
        "source_end_min_pages": {
          "type": "integer",
          "minimum": 1
        },
        "list_min_facts": {
          "type": "integer",
          "minimum": 1
        },
        "regular_months": {
          "type": "integer",
          "minimum": 1
        },
        "recent_months": {
          "type": "integer",
          "minimum": 1
        },
        "gap_min_months": {
          "type": "integer",
          "minimum": 1
        },
        "list_share": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "header_min_pages",
        "source_end_min_pages",
        "list_min_facts",
        "list_share",
        "regular_months",
        "recent_months",
        "gap_min_months"
      ]
    },
    "outside_expertise_parts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "description": "Question-part keys the expert still answers when a question is outside their expertise."
    }
  },
  "additionalProperties": false,
  "required": [
    "code",
    "name",
    "version",
    "profession",
    "record_gaps"
  ]
}
