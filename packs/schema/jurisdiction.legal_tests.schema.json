{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legal tests front matter",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "placeholders": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "approved",
        "retired"
      ]
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ]
}
