{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public holidays snapshot",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "covers_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "covers_until": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "required": [
    "covers_from",
    "covers_until",
    "dates"
  ]
}
