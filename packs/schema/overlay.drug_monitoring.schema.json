{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drug monitoring table",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "drugs": {
      "type": "array"
    }
  },
  "additionalProperties": false,
  "required": [
    "drugs"
  ]
}
