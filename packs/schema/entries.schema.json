{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Record entries",
  "type": "object",
  "properties": {
    "entry_kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "enabled": {"type": "boolean"},
          "label": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$", "description": "An i18n key, never display text."},
          "transcript": {"enum": ["include", "exclude"], "description": "include: laid out in the records transcript. exclude: administrative, folded to one line."},
          "letter": {"type": "boolean", "description": "The one kind the transcript lays out as a letter."}
        },
        "additionalProperties": false,
        "required": ["key", "label", "transcript"]
      }
    },
    "author_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "enabled": {"type": "boolean"},
          "label": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"}
        },
        "additionalProperties": false,
        "required": ["key", "label"]
      }
    }
  },
  "additionalProperties": false,
  "required": ["entry_kinds", "author_roles"]
}
